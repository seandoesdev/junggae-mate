# API 서버 앞단 HTTPS — Let's Encrypt 자동 발급·갱신, 443 포트만 사용
# 실행: docker compose --profile https up -d   (.env에 API_DOMAIN, ACME_EMAIL 필요)
# - 인증서 확인은 TLS-ALPN-01 방식(443으로 확인)만 쓴다. 80 포트는 열지 않아도 된다
# - API_DOMAIN의 A 레코드가 이 서버의 공인 IP를 가리키고, 밖에서 443(TCP)으로 들어올 수 있어야 한다
# - 인증서는 caddy_data 볼륨에 저장되고 만료 전에 자동 갱신된다
{
	email {$ACME_EMAIL}
	# 80 포트를 쓰지 않으므로 http→https 전환도 하지 않는다
	auto_https disable_redirects
}

{$API_DOMAIN} {
	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
			disable_http_challenge
		}
	}

	encode zstd gzip

	# 응답 보안 헤더 (CORS 헤더는 FastAPI가 붙인다)
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}

	reverse_proxy app:8000
}
