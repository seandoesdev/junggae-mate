# 복사해서 .env 로 사용하세요. .env는 커밋하지 마세요.
APP_PORT=8000
POSTGRES_PASSWORD=mate
# 운영에서는 반드시 긴 임의 값으로 교체
JWT_SECRET=change-me-to-a-long-random-string

# LLM (선택). 비워 두면 규칙 기반(template) 초안 생성기로 동작합니다.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# [필수] 공공데이터포털(data.go.kr) 일반 인증키
# 아래 활용신청 API가 공통으로 사용하는 키입니다.
# - 15126468 국토교통부 아파트 매매 실거래가 상세 자료
# - 15126474 국토교통부 아파트 전월세 실거래가 자료
# - 15058453 국토교통부 공동주택 기본정보 서비스(K-apt)
# - 15134735 국토교통부 건축HUB 건축물대장정보 서비스
# - 15098554 국토교통부 TAGO 지하철정보
# 마이페이지 > 데이터 활용 > Open API > 인증키에서 확인합니다.
# Encoding/Decoding 키 중 어느 쪽이든 사용할 수 있습니다.
# 실제 값은 이 예제 파일이 아니라 .env에만 입력하세요.
DATA_GO_KR_SERVICE_KEY=

# [선택] VWorld 개발자센터에서 발급한 지도·공간정보 운영키
VWORLD_API_KEY=
# [선택] VWorld 키 신청 시 등록한 서비스 도메인(예: https://example.com)
VWORLD_API_DOMAIN=
# [선택] 도로명주소 개발자센터에서 발급한 승인키
JUSO_API_KEY=
# [선택] 국가법령정보 공동활용에서 발급한 OC 기관 ID
LAW_GO_KR_OC=
