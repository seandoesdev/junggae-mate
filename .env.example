# 복사해서 .env 로 사용하세요. .env는 커밋하지 마세요.
APP_PORT=8000
POSTGRES_PASSWORD=mate
# 운영에서는 반드시 긴 임의 값으로 교체
JWT_SECRET=change-me-to-a-long-random-string

# 회원가입(새 사무소 만들기)을 받을지. 0이면 기존 계정만 로그인
SIGNUP_ENABLED=1
# 시연용 예시 데이터(예시 사무소·계정·매물)를 기동 때 넣을지. 운영에서는 0으로 — 예시 계정 비밀번호가 코드에 공개돼 있다
SEED_ON_START=1

# [화면을 Cloudflare 등 다른 주소에서 내려줄 때] API를 부를 수 있는 화면 주소. 쉼표로 여러 개.
# 예: CORS_ORIGINS=https://junggae-mate.kro.kr,https://junggae-mate.pages.dev
CORS_ORIGINS=
# [선택] 미리보기 배포처럼 주소가 바뀌는 화면을 정규식으로 허용
# 예: CORS_ORIGIN_REGEX=^https://[0-9a-f]{8}\.junggae-mate\.pages\.dev$
CORS_ORIGIN_REGEX=
# [선택] 고객 공유 링크(/r/...)에 쓸 이 API 서버의 공개 주소. 프록시(https) 뒤라면 적어 둔다. 예: https://api.example.com
PUBLIC_BASE_URL=

# [선택] API 서버 HTTPS — Let's Encrypt 인증서 자동 발급·갱신 (docker compose --profile https up -d)
# API_DOMAIN의 A 레코드를 이 서버 공인 IP로 두고 443 포트를 연다(인증서 확인도 443). 쓰면 아래 셋을 함께 바꾼다:
#   APP_PORT=127.0.0.1:8000   (8000을 밖으로 열지 않고 nginx(443)만 공개)
#   FORWARDED_ALLOW_IPS=*     (nginx가 알려 준 https를 앱이 믿도록)
#   PUBLIC_BASE_URL=https://<API_DOMAIN>
# 도메인 대신 서버 공인 IP도 된다(예: 49.247.130.188) -> Let's Encrypt 단기 인증서(약 6일, 자동 갱신), kro.kr 한도와 무관
#   그때는 PUBLIC_BASE_URL=https://<IP>, 화면(Cloudflare Pages)의 API_URL도 https://<IP>
API_DOMAIN=
# [선택] Let's Encrypt 만료 안내 이메일
ACME_EMAIL=
# 발급 서버: letsencrypt(기본) | letsencrypt_test(스테이징, 시험용). 확인 방식: alpn(기본, 443만) | http(80 포트)
# kro.kr 같은 공유 무료 도메인은 Let's Encrypt의 도메인당 주 50장 한도에 걸릴 수 있다(rateLimited) → 로그의 retry after 이후 acme 재시작
ACME_SERVER=letsencrypt
ACME_CHALLENGE=alpn
# 위 프로필을 늘 켜 두려면 (docker compose up -d만으로 nginx·acme까지)
# COMPOSE_PROFILES=https

# LLM (선택). 비워 두면 규칙 기반(template) 초안 생성기로 동작합니다.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# [필수] 공공데이터포털(data.go.kr) 일반 인증키
# 아래 활용신청 API가 공통으로 사용하는 키입니다.
# - 15126468 국토교통부 아파트 매매 실거래가 상세 자료
# - 15126474 국토교통부 아파트 전월세 실거래가 자료
# - 15058453 국토교통부 공동주택 기본정보 서비스(K-apt)
# - 15134735 국토교통부 건축HUB 건축물대장정보 서비스
# - 15098554 국토교통부 TAGO 지하철정보
# 마이페이지 > 데이터 활용 > Open API > 인증키에서 확인합니다.
# Encoding/Decoding 키 중 어느 쪽이든 사용할 수 있습니다.
# 실제 값은 이 예제 파일이 아니라 .env에만 입력하세요.
DATA_GO_KR_SERVICE_KEY=

# [권장] 네이버 클라우드 Maps(Dynamic Map) 애플리케이션 인증 정보. 비우면 지도는 OpenStreetMap
# 콘솔의 Web 서비스 URL에 화면 주소(https://junggae-mate.kro.kr, http://localhost:5173 등)를 등록해야 한다.
# Client ID는 화면 지도 스크립트에 실리는 공개 값, Secret은 서버 전용(화면에 보내지 않음)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# [권장] 고객·의뢰인 연락처와 출입 정보를 암호화하는 키 (Fernet, 32바이트 URL-safe base64)
# 만들기: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 비우면 JWT_SECRET에서 파생한 키를 쓴다. 나중에 넣어도 기존 값은 그대로 읽힌다. 한 번 넣은 키는 바꾸거나 잃어버리지 말 것
DATA_ENCRYPTION_KEY=

# [선택] VWorld 개발자센터에서 발급한 지도·공간정보 운영키
VWORLD_API_KEY=
# [선택] VWorld 키 신청 시 등록한 서비스 도메인(예: https://example.com)
VWORLD_API_DOMAIN=
# [선택] 도로명주소 개발자센터에서 발급한 승인키
JUSO_API_KEY=
# [선택] 국가법령정보 공동활용에서 발급한 OC 기관 ID
LAW_GO_KR_OC=
