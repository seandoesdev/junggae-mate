# 복사해서 .env 로 사용하세요. .env는 커밋하지 마세요.
APP_PORT=8000
POSTGRES_PASSWORD=mate
# 운영에서는 반드시 긴 임의 값으로 교체
JWT_SECRET=change-me-to-a-long-random-string

# [화면을 Cloudflare 등 다른 주소에서 내려줄 때] API를 부를 수 있는 화면 주소. 쉼표로 여러 개.
# 예: CORS_ORIGINS=https://junggae-mate.kro.kr,https://junggae-mate.pages.dev
CORS_ORIGINS=
# [선택] 미리보기 배포처럼 주소가 바뀌는 화면을 정규식으로 허용
# 예: CORS_ORIGIN_REGEX=^https://[0-9a-f]{8}\.junggae-mate\.pages\.dev$
CORS_ORIGIN_REGEX=
# [선택] 고객 공유 링크(/r/...)에 쓸 이 API 서버의 공개 주소. 프록시(https) 뒤라면 적어 둔다. 예: https://api.example.com
PUBLIC_BASE_URL=

# [선택] API 서버 HTTPS — Let's Encrypt 자동 발급 (docker compose --profile https up -d)
# API_DOMAIN의 A 레코드를 이 서버 공인 IP로 두고 443 포트만 연다(인증서 확인도 443). 쓰면 아래 셋을 함께 바꾼다:
#   APP_PORT=127.0.0.1:8000   (8000을 밖으로 열지 않고 caddy만 공개)
#   FORWARDED_ALLOW_IPS=*     (caddy가 알려 준 https를 앱이 믿도록)
#   PUBLIC_BASE_URL=https://<API_DOMAIN>
API_DOMAIN=
# Let's Encrypt 만료 안내를 받을 이메일
ACME_EMAIL=

# LLM (선택). 비워 두면 규칙 기반(template) 초안 생성기로 동작합니다.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# [필수] 공공데이터포털(data.go.kr) 일반 인증키
# 아래 활용신청 API가 공통으로 사용하는 키입니다.
# - 15126468 국토교통부 아파트 매매 실거래가 상세 자료
# - 15126474 국토교통부 아파트 전월세 실거래가 자료
# - 15058453 국토교통부 공동주택 기본정보 서비스(K-apt)
# - 15134735 국토교통부 건축HUB 건축물대장정보 서비스
# - 15098554 국토교통부 TAGO 지하철정보
# 마이페이지 > 데이터 활용 > Open API > 인증키에서 확인합니다.
# Encoding/Decoding 키 중 어느 쪽이든 사용할 수 있습니다.
# 실제 값은 이 예제 파일이 아니라 .env에만 입력하세요.
DATA_GO_KR_SERVICE_KEY=

# [선택] VWorld 개발자센터에서 발급한 지도·공간정보 운영키
VWORLD_API_KEY=
# [선택] VWorld 키 신청 시 등록한 서비스 도메인(예: https://example.com)
VWORLD_API_DOMAIN=
# [선택] 도로명주소 개발자센터에서 발급한 승인키
JUSO_API_KEY=
# [선택] 국가법령정보 공동활용에서 발급한 OC 기관 ID
LAW_GO_KR_OC=
